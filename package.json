{
  "name": "kairo-quick-capture",
  "version": "3.4.17",
  "description": "Fast, local-first scratchpad capture for Obsidian.",
  "main": "publish/main.js",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check:release": "node scripts/check-release.mjs"
  },
  "keywords": [
    "obsidian",
    "capture",
    "inbox",
    "productivity"
  ],
  "author": "Rahul",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "builtin-modules": "^5.0.0",
    "esbuild": "^0.27.0",
    "obsidian": "^1.8.7",
    "typescript": "^5.9.3"
  }
}
